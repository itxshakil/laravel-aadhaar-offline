# Absolute path(s) to the UIDAI Offline e-KYC public certificate, comma-separated
AADHAAR_OFFLINE_CERTIFICATES=

# Only set to false for local development
AADHAAR_OFFLINE_VERIFY_SIGNATURE=true

# Reject Offline e-KYC files older than this many days (null to disable)
AADHAAR_OFFLINE_MAX_AGE_DAYS=3

# Reject Secure QR codes older than this many days (empty = no limit; printed cards are old)
AADHAAR_OFFLINE_QR_MAX_AGE_DAYS=

# Private disk for AadhaarOffline::storePhoto()
AADHAAR_OFFLINE_PHOTO_DISK=local

AADHAAR_OFFLINE_EVENTS=true
