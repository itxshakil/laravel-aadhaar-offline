{
    "name": "itxshakil/laravel-aadhaar-offline",
    "description": "Read and verify Aadhaar Offline e-KYC (share-code ZIP / signed XML) locally in Laravel: UIDAI signature checks, mobile/email hash matching, freshness rules and privacy-safe defaults.",
    "keywords": [
        "laravel",
        "laravel-package",
        "php",
        "aadhaar",
        "aadhaar-offline",
        "offline-ekyc",
        "paperless-kyc",
        "ekyc",
        "kyc",
        "uidai",
        "xml-signature",
        "verhoeff",
        "india",
        "fintech"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Shakil Alam",
            "email": "itxshakil@gmail.com",
            "homepage": "https://github.com/itxshakil",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "robrichards/xmlseclibs": "^4.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "ext-fileinfo": "Accurate MIME detection for the resident photo"
    },
    "autoload": {
        "psr-4": {
            "Shakil\\AadhaarOffline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shakil\\AadhaarOffline\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shakil\\AadhaarOffline\\AadhaarOfflineServiceProvider"
            ],
            "aliases": {
                "AadhaarOffline": "Shakil\\AadhaarOffline\\Facades\\AadhaarOffline"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:real": "phpunit --testsuite Real",
        "test:coverage": "phpunit --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process",
        "lint:fix": [
            "@rector",
            "pint --dirty"
        ],
        "lint": [
            "@analyse",
            "pint --test --parallel"
        ],
        "qa": [
            "@lint",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "test:real": "Run the opt-in tests against a real Offline e-KYC file (see tests/Real)",
        "rector": "Run Rector to automatically refactor and modernise code",
        "test:coverage": "Run the PHPUnit test suite with code coverage reporting",
        "analyse": "Run static analysis using PHPStan",
        "lint:fix": "Automatically fix code style issues using Rector and Laravel Pint",
        "lint": "Run static analysis and code style checks without modifying files",
        "qa": "Run full quality assurance checks (lint + tests)"
    },
    "support": {
        "issues": "https://github.com/itxshakil/laravel-aadhaar-offline/issues",
        "source": "https://github.com/itxshakil/laravel-aadhaar-offline",
        "docs": "https://github.com/itxshakil/laravel-aadhaar-offline/tree/main/docs"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
